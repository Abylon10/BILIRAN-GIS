# Copy to .env.local and fill in real values. Never commit .env.local —
# .gitignore's `.env*` pattern covers it (this file is explicitly
# un-ignored via `!.env.example` so it stays tracked as a template).

# Supabase (lib/supabase.ts / lib/supabaseAdmin.ts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — sends the invitation-code email (lib/email.ts). Get a key at
# https://resend.com/api-keys. If unset, creating/editing an invitation
# still works; the email just doesn't send (lib/email.ts degrades
# gracefully and the admin panel shows the code so it can be shared
# manually — see components/AdminInvitePanel.tsx).
RESEND_API_KEY=
# Optional. Overrides the default shared onboarding@resend.dev sender —
# set this once a custom domain is verified in Resend. Format:
# "Display Name <address@yourdomain>".
RESEND_FROM_ADDRESS=
